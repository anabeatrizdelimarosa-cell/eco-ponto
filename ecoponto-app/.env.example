# ==============================================================================
# ECOPONTO INTELIGENTE • VARIÁVEIS DE AMBIENTE DE EXEMPLO (.env.example)
# NUNCA insira credenciais reais neste arquivo. Copie para .env e preencha localmente.
# ==============================================================================

# Porta do Servidor Web Local
PORT=3011
VITE_PORT=3011

# Ambiente de Execução (development, test, production)
NODE_ENV=development

# Configuração de Conexão com o Banco de Dados (PostgreSQL / Supabase / Neon)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoponto_ro
DB_USER=postgres
DB_PASS=sua_senha_local

# String de Conexão Completa para ORMs ou Clientes de Banco
DATABASE_URL=postgresql://postgres:sua_senha_local@localhost:5432/ecoponto_ro?sslmode=prefer

# Senha Mestra de Auditoria para o Painel Administrativo SEMA (Padrão de Avaliação: admin)
ADMIN_MASTER_KEY=admin

# URL da Aplicação Publicada na Vercel
VITE_PUBLIC_URL=https://eco-ponto-rho.vercel.app
